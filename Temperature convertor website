<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Temperature Converter</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <div class="container">

        <!-- Header -->
        <div class="header">
            <h1>Temperature Converter</h1>

            <p>
                Convert temperatures between Celsius, Fahrenheit and Kelvin.
            </p>
        </div>


        <!-- Converter Card -->
        <div class="converter-card">

            <!-- Temperature Input -->
            <div class="input-group">

                <label for="temperature">
                    Enter Temperature
                </label>

                <input
                    type="number"
                    id="temperature"
                    placeholder="Enter value"
                    step="any"
                >

            </div>


            <!-- Unit Selector -->
            <div class="input-group">

                <label for="unit">
                    Select Input Unit
                </label>

                <select id="unit">

                    <option value="celsius">
                        Celsius (°C)
                    </option>

                    <option value="fahrenheit">
                        Fahrenheit (°F)
                    </option>

                    <option value="kelvin">
                        Kelvin (K)
                    </option>

                </select>

            </div>


            <!-- Convert Button -->

            <button id="convertBtn">
                Convert Temperature
            </button>


            <!-- Error Message -->

            <div id="errorMessage" class="error">
            </div>


            <!-- Results -->

            <div id="results" class="results">

                <h2>Converted Temperature</h2>

                <div class="result-box">

                    <div class="result">
                        <span>Celsius</span>
                        <strong id="celsiusResult">--</strong>
                    </div>


                    <div class="result">
                        <span>Fahrenheit</span>
                        <strong id="fahrenheitResult">--</strong>
                    </div>


                    <div class="result">
                        <span>Kelvin</span>
                        <strong id="kelvinResult">--</strong>
                    </div>

                </div>

            </div>

        </div>


        <!-- Information -->

        <div class="info">

            <h3>Conversion Formulas</h3>

            <p>
                <strong>Celsius → Fahrenheit:</strong>
                °F = (°C × 9/5) + 32
            </p>

            <p>
                <strong>Fahrenheit → Celsius:</strong>
                °C = (°F − 32) × 5/9
            </p>

            <p>
                <strong>Celsius → Kelvin:</strong>
                K = °C + 273.15
            </p>

        </div>


        <!-- Footer -->

        <footer>
            <p>© 2026 Temperature Converter</p>
        </footer>

    </div>


    <script src="script.js"></script>

</body>
</html>
